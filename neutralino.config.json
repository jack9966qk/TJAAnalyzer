{
  "applicationId": "js.neutralino.tjaanalyzer",
  "version": "0.10.2",
  "defaultMode": "window",
  "documentRoot": "dist",
  "url": "/index.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": ["app.*", "os.*", "filesystem.*", "debug.log"],
  "tokenSecurity": "one-time",
  "modes": {
    "window": {
      "title": "TJA Analyzer",
      "width": 1280,
      "height": 800,
      "minWidth": 800,
      "minHeight": 600,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "icon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryVersion": "6.4.0",
    "clientVersion": "6.4.0",
    "distributionPath": "release",
    "binaryName": "TJAAnalyzer",
    "resourcesPath": "/dist"
  },
  "buildScript": {
    "mac": {
      "architecture": ["x64", "arm64", "universal"],
      "minimumOS": "10.13.0",
      "appName": "TJAAnalyzer",
      "appBundleName": "TJAAnalyzer",
      "appIdentifier": "js.neutralino.tjaanalyzer",
      "appIcon": "icon.png"
    },
    "win": {
      "architecture": ["x64"],
      "appName": "TJAAnalyzer",
      "appIcon": "icon.png"
    },
    "linux": {
      "architecture": ["x64", "arm64", "armhf"],
      "appName": "TJAAnalyzer",
      "appIcon": "icon.png",
      "appPath": "/usr/share/TJAAnalyzer",
      "appIconPath": "/usr/share/TJAAnalyzer/icon.png"
    }
  }
}
