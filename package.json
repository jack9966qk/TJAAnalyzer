{
  "name": "tja-analyzer",
  "version": "0.10.2",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prepare-data": "node --loader ts-node/esm prepare-data.ts",
    "build-data": "node --loader ts-node/esm build-data.ts",
    "build": "npm run build-data && tsc --noEmit && vite build",
    "dev": "npm run build-data && npm run --prefix renderer-package build && npm-run-all --parallel dev:renderer \"dev:vite -- {@}\" --",
    "dev:renderer": "npm run --prefix renderer-package watch",
    "dev:vite": "vite",
    "start": "vite preview --port 8080",
    "test": "npm run build && node --loader ts-node/esm tests/test-parser.ts && node --loader ts-node/esm tests/test-exporter.ts && playwright test",
    "build:exe": "npm run build && node build-exe.js",
    "start:exe": "npm run build && neu update && neu run",
    "deploy": "npm run build && gh-pages -d dist",
    "format": "biome check --write .",
    "release": "./release.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@neutralinojs/neu": "^11.6.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.1",
    "gh-pages": "^6.3.0",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-static-copy": "^3.2.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@neutralinojs/lib": "^6.4.0",
    "tja-renderer": "file:renderer-package",
    "webjsx": "^0.0.73"
  }
}
