{
  "name": "tja-analyzer",
  "version": "0.7.3",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "fetch-ese": "node fetch-ese-assets.js",
    "build": "tsc && node prepare-dist.js",
    "test": "npm run build && node --loader ts-node/esm tests/test-parser.ts && node --loader ts-node/esm tests/test-exporter.ts && playwright test",
    "start": "npm run build && http-server dist -c-1",
    "build:exe": "npm run build && neu update && neu build",
    "start:exe": "npm run build && neu update && neu run",
    "deploy": "npm run build && gh-pages -d dist",
    "format": "biome check --write .",
    "generate-mapping": "node --loader ts-node/esm generate-song-mapping.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@neutralinojs/neu": "^11.6.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.1",
    "gh-pages": "^6.3.0",
    "http-server": "^14.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@neutralinojs/lib": "^6.4.0",
    "webjsx": "^0.0.73"
  }
}
